source("C:/Users/sudhi/Desktop/FALL 2026/STA 5721/HW1 Solution/coordinate_descent.R")
# Parameters
N <- 300
p <- 50
lambda <- 0.22
cov.matrix <- array(NA, dim = c(p, p))
for(j in 1:p){
for(k in 1:p){
cov.matrix[j, k] <- 0.35 ** abs(j - k)
}
}
# Define True Beta vector with specific sparse non-zero coefficients
True.beta <- numeric(p)
nonzero.coeff.index <- c(1, 7, 15, 26, 40)
nonzero.coeffs <- c(2.5, -2, 1.5, -1.25, 1)
True.beta[nonzero.coeff.index] <- nonzero.coeffs
# Simulate predictor matrix X and response vector y
set.seed(123)
data.X <- mvrnorm(n = N, mu = rep(0, p), Sigma = cov.matrix)
data.y <- data.X %*% True.beta + rnorm(N, 0, 0.75)
data.X <- sweep(data.X, 2, colMeans(data.X), "-")
data.X <- sweep(data.X, 2, sqrt(colMeans(data.X^2)), "/")
data.y <- data.y - mean(data.y)
# partial residual function
RESULT.partial <- lasso_cd_partial_residual(data.X, data.y, lambda)
time.partial <- system.time({
lasso_cd_partial_residual(data.X, data.y, lambda)
})
# residual update function
RESULT.update <- lasso_cd_residual_update(data.X, data.y, lambda)
time.update <- system.time({
lasso_cd_residual_update(data.X, data.y, lambda)
})
cat(RESULT.partial[["beta"]][which(RESULT.partial[["beta"]]!=0)])
which(RESULT.partial != 0)
