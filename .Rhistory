rm(list = ls())
library(MASS)
source("C:/Users/sudhi/Desktop/FALL 2026/STA 5721/HW1 Solution/coordinate_descent.R")
# Parameters
N <- 300
p <- 50
lambda <- 0.22
cov.matrix <- array(NA, dim = c(p, p))
for(j in 1:p){
for(k in 1:p){
cov.matrix[j, k] <- 0.35 ** abs(j - k)
}
}
# Define True Beta vector with specific sparse non-zero coefficients
True.beta <- numeric(p)
nonzero.coeff.index <- c(1, 7, 15, 26, 40)
nonzero.coeffs <- c(2.5, -2, 1.5, -1.25, 1)
True.beta[nonzero.coeff.index] <- nonzero.coeffs
# Simulate predictor matrix X and response vector y
set.seed(123)
data.X <- mvrnorm(n = N, mu = rep(0, p), Sigma = cov.matrix)
data.y <- data.X %*% True.beta + rnorm(N, 0, 0.75)
data.X <- sweep(data.X, 2, colMeans(data.X), "-")
data.X <- sweep(data.X, 2, sqrt(colMeans(data.X^2)), "/")
data.y <- data.y - mean(data.y)
# partial residual function
RESULT.partial <- lasso_cd_partial_residual(data.X, data.y, lambda)
time.partial <- system.time({
lasso_cd_partial_residual(data.X, data.y, lambda)
})
# residual update function
RESULT.update <- lasso_cd_residual_update(data.X, data.y, lambda)
time.update <- system.time({
lasso_cd_residual_update(data.X, data.y, lambda)
})
N <- 300
# all.p <- c(500, 1000, 1500, 2000)
all.p <- c(500, 600)
list.partial <- list('500'=NULL, '1000'=NULL, '1500'=NULL, '2000'=NULL)
list.fullupdate <- list('500'=NULL, '1000'=NULL, '1500'=NULL, '2000'=NULL)
median.partial <- vector("numeric", length=length(all.p))
median.update <- vector("numeric", length=length(all.p))
Diffs <- vector("numeric", 10*length(all.p))
for(idx in seq_along(all.p)){
TRUE.BETAs <- c(True.beta, rep(0, all.p[idx] - 50))
set.seed(123*all.p[idx])
cov.matrix <- array(NA, dim = c(all.p[idx], all.p[idx]))
for(j in 1:all.p[idx]){
for(k in 1:all.p[idx]){
cov.matrix[j, k] <- 0.35 ** abs(j - k)
}
}
data.X <- mvrnorm(n = N, mu = rep(0, all.p[idx]), Sigma = cov.matrix)
data.y <- data.X %*% TRUE.BETAs + rnorm(N, 0, 0.75)
data.X <- sweep(data.X, 2, colMeans(data.X), "-")
data.X <- sweep(data.X, 2, sqrt(colMeans(data.X^2)), "/")
data.y <- data.y - mean(data.y)
tmp1 <- vector("numeric", 10)
tmp2 <- vector("numeric", 10)
est.beta1 <- NULL
est.beta2 <- NULL
for(i in 1:10){
tmp1[[i]] <- system.time({
res1 <- lasso_cd_partial_residual(data.X, data.y, lambda, beta_init=est.beta1, tol=1e-6)
})[["user.self"]]
tmp2[[i]] <- system.time({
res2 <- lasso_cd_residual_update(data.X, data.y, lambda, beta_init=est.beta2, tol=1e-6)
})[["user.self"]]
est.beta1 <- res1[['beta']]
est.beta2 <- res2[['beta']]
print(est.beta1[which(est.beta1 != 0 )])
print(est.beta2[which(est.beta2 != 0 )])
cat('\n\nFor p = ', all.p[idx], ' and iteration = ', i, "\n\n")
cat('Position of non-zero coeff. for partial residual: ')
cat(which(res1[['beta']] != 0), "\n")
cat('Position of non-zero coeff. for full residual:    ')
cat(which(res2[['beta']] != 0), "\n")
cat('Value of non-zero coeff. for partial residual: ')
cat(res1[["beta"]][which(res1[['beta']] != 0)], "\n")
cat('Value of non-zero coeff. for full residual:    ')
cat(res2[["beta"]][which(res2[['beta']] != 0)], "\n")
cat("Max. Absolute Difference between Estimates", max(abs(res1[['beta']] - res2[['beta']])))
}
median.partial[idx] <- median(tmp1)
median.update[idx] <- median(tmp2)
}
plot(all.p, median.partial,
type = "o",
col = "blue",
xlab = "Number of variables (p)",
ylab = "Median Computational Time (in sec)",
main = "Compute Time in Lasso: Partial Residual vs Full Residual Update",
ylim = c(-1, 9))
lines(all.p, median.update,
type = "o",
col = "red")
legend("topleft",
legend = c("Partial Residual", "Full Residual"),
col = c("blue", "red"),
lty = 1,
pch = 1)
