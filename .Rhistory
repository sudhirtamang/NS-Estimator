set.seed(5721)
N <- 300
p <- 50
rho <- 0.35
# Generate correlated Gaussian predictors.
Z <- matrix(rnorm(N * p), nrow = N, ncol = p)
X <- Z
for (j in 2:p) {
X[, j] <- rho * X[, j - 1] + sqrt(1 - rho^2) * Z[, j]
}
# Center the columns and make (1/N) * sum_i X[i,j]^2 equal to 1.
X <- sweep(X, 2, colMeans(X), "-")
X <- sweep(X, 2, sqrt(colMeans(X^2)), "/")
dim(X)
tmp1 <- sweep(data.X, 2, colMeans(X), "-")
tmp1 <- sweep(data.X, 2, sqrt(colMeans(X^2)), "/")
sum(tmp1[, 1] ** 2)
tmp1 <- sweep(data.X, 2, colMeans(data.X), "-")
tmp1 <- sweep(tmp1, 2, sqrt(colMeans(tmp1^2)), "/")
sum(tmp1[, 1] ** 2)
